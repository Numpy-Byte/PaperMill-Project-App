<AnchorPane prefHeight="471.0" prefWidth="633.0" style="-fx-background-color: #FDFBF0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cse213.papermillapp.RecordDeliveryController">
   <children>
