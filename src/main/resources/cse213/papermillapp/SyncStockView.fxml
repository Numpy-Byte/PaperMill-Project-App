<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="471.0" prefWidth="629.0" style="-fx-background-color: #FDFBF0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cse213.papermillapp.SyncStockController">
   <children>
      <Button layoutX="14.0" layoutY="425.0" mnemonicParsing="false" onAction="#backButtonOnClick" text="Back to Dashboard" />
      <Label alignment="CENTER" layoutX="130.0" layoutY="1.0" prefHeight="53.0" prefWidth="401.0" text="Sync Digital Stock">
         <font>
            <Font name="Bookman Old Style Bold" size="18.0" />
         </font>
      </Label>
      <Label layoutX="207.0" layoutY="120.0" text="Product ID:" />
      <TextField fx:id="idField" layoutX="273.0" layoutY="116.0" prefHeight="25.0" prefWidth="174.0" promptText="Enter Product ID" />
      <Label layoutX="186.0" layoutY="165.0" text="Product Name:" />
      <TextField fx:id="nameField" layoutX="273.0" layoutY="161.0" prefHeight="25.0" prefWidth="174.0" promptText="Enter Product Name" />
      <Label layoutX="181.0" layoutY="208.0" text="Quantity to Add:" />
      <TextField fx:id="qtyField" layoutX="273.0" layoutY="204.0" prefHeight="25.0" prefWidth="174.0" promptText="Enter Quantity" />
      <Button layoutX="276.0" layoutY="252.0" mnemonicParsing="false" onAction="#syncStockButtonOnClick" prefHeight="44.0" prefWidth="140.0" style="-fx-background-color: linear-gradient(to bottom, #2D5A27, #1E3C1A); -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 10;" text="Sync Stock">
         <font>
            <Font name="Elephant" size="12.0" />
         </font></Button>
      <Label fx:id="statusLabel" alignment="CENTER" layoutX="1.0" layoutY="327.0" prefHeight="74.0" prefWidth="629.0" />
      <ImageView fitHeight="84.0" fitWidth="123.0" pickOnBounds="true" preserveRatio="true" />
      <Button layoutX="546.0" layoutY="15.0" mnemonicParsing="false" onAction="#logoutOnClick" prefHeight="25.0" prefWidth="65.0" text="Logout" />
      <ImageView fitHeight="84.0" fitWidth="123.0" layoutX="1.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../Images/PaperMill%20Logo.png" />
         </image>
         <effect>
            <DropShadow />
         </effect>
      </ImageView>
   </children>
</AnchorPane>
